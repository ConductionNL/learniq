{
	"$schema": "https://github.com/ConductionNL/nextcloud-vue/raw/main/src/schemas/app-manifest-v2.schema.json",
	"version": "0.1.0",
	"dependencies": [
		"openregister",
		{
			"id": "openconnector",
			"required": false,
			"name": "OpenConnector"
		}
	],
	"observability": {
		"health": {
			"statusCodePolicy": "adr006",
			"checks": [
				{
					"id": "database",
					"type": "database",
					"severity": "critical"
				},
				{
					"id": "or",
					"type": "orAvailable",
					"severity": "critical"
				},
				{
					"id": "launchpad",
					"type": "appEnabled",
					"app": "launchpad",
					"severity": "degraded"
				}
			]
		},
		"metrics": [
			{
				"name": "learniq_courses_total",
				"type": "gauge",
				"help": "Number of Course objects in the Learniq register.",
				"source": {
					"kind": "objectCount",
					"register": "learniq",
					"schema": "course"
				}
			},
			{
				"name": "learniq_enrolments_total",
				"type": "gauge",
				"help": "Number of Enrolment objects in the Learniq register.",
				"source": {
					"kind": "objectCount",
					"register": "learniq",
					"schema": "enrolment"
				}
			},
			{
				"name": "learniq_learner_profiles_total",
				"type": "gauge",
				"help": "Number of LearnerProfile objects in the Learniq register.",
				"source": {
					"kind": "objectCount",
					"register": "learniq",
					"schema": "learner-profile"
				}
			}
		]
	},
	"deepLinks": [
		{
			"registerSlug": "learniq",
			"schemaSlug": "course",
			"urlTemplate": "/apps/learniq/#/courses/{uuid}",
			"displayName": "Course"
		},
		{
			"registerSlug": "learniq",
			"schemaSlug": "enrolment",
			"urlTemplate": "/apps/learniq/#/enrolments/{uuid}",
			"displayName": "Enrolment"
		},
		{
			"registerSlug": "learniq",
			"schemaSlug": "learner-profile",
			"urlTemplate": "/apps/learniq/#/learner-profiles/{uuid}",
			"displayName": "Learner"
		},
		{
			"registerSlug": "learniq",
			"schemaSlug": "credential",
			"urlTemplate": "/apps/learniq/#/credentials/{uuid}",
			"displayName": "Credential"
		},
		{
			"registerSlug": "learniq",
			"schemaSlug": "support-request",
			"urlTemplate": "/apps/learniq/#/support-requests/{uuid}",
			"displayName": "Support request"
		}
	],
	"menu": [
		{
			"id": "Documentation",
			"label": "Documentation",
			"icon": "BookOpenVariantOutline",
			"href": "https://learniq.conduction.nl",
			"section": "footer",
			"order": 90
		},
		{
			"id": "FeaturesRoadmapMenu",
			"label": "Features & roadmap",
			"icon": "MapMarkerPath",
			"route": "FeaturesRoadmap",
			"section": "footer",
			"order": 100
		},
		{
			"id": "XapiStatementsMenu",
			"label": "xAPI statements",
			"icon": "History",
			"route": "XapiStatements",
			"section": "settings",
			"order": 94
		},
		{
			"id": "Rollover",
			"label": "School-year rollover",
			"icon": "History",
			"route": "RolloverWizard",
			"order": 46,
			"visibleIf": {
				"user.primaryRole": {
					"in": ["admin"]
				}
			}
		},
		{
			"id": "FlowsMenu",
			"label": "Flows",
			"icon": "Sitemap",
			"route": "Flows",
			"section": "settings",
			"order": 96
		}
	],
	"pages": [
		{
			"id": "FeaturesRoadmap",
			"route": "/features-roadmap",
			"type": "roadmap",
			"title": "Features & roadmap",
			"config": {
				"documentationUrl": "https://learniq.conduction.nl"
			}
		},
		{
			"id": "XapiStatements",
			"route": "/xapi-statements",
			"type": "index",
			"title": "xAPI statements",
			"config": {
				"register": "learniq",
				"schema": "xapi-statement",
				"readOnly": true
			}
		},
		{
			"id": "XapiStatementDetail",
			"route": "/xapi-statements/:id",
			"type": "detail",
			"title": "xAPI statement",
			"config": {
				"register": "learniq",
				"schema": "xapi-statement",
				"readOnly": true,
				"_note": "An xAPI Statement is an immutable learning-experience event (actor, verb, object, result, context, timestamp, authority) — a log/technical archetype. Body leads with the statement data including the full actor/verb/object/result JSON (wide, 12-col, single column for readability) and a Related panel resolving the linked course/lesson. NO comms leaves, NO child rosters — an xAPI statement is a write-once event. Sidebar keeps metadata + audit-trail.",
				"widgets": [
					{
						"id": "xapi-data",
						"type": "data",
						"title": "Data",
						"content": {
							"columns": 1
						},
						"icon": "Timeline"
					},
					{
						"id": "xapi-related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "xapi-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 5,
						"showTitle": false
					},
					{
						"id": "2",
						"widgetId": "xapi-related",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 5,
						"showTitle": false
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "RolloverWizard",
			"route": "/structure/rollover",
			"type": "custom",
			"title": "School-year rollover",
			"component": "RolloverWizard",
			"_note": "Mapping editor for the jaarovergang (school-year-rollover): the \"custom view only where a manifest page cannot render it\" exception. Proposes a leerjaar-increment default mapping, runs the mandatory side-effect-free preview gate, and triggers the idempotent server-side execution (RolloverExecutionHandler) by transitioning the RolloverPlan to executing."
		},
		{
			"id": "Flows",
			"route": "/flows",
			"type": "flows",
			"title": "Flows",
			"config": { "app": "learniq" },
			"_note": "ADR-110 Decision 4: a flow is app-specific, so the authoring surface lives here rather than behind a deep link to another app's list. Rendered by the shared CnFlowsPage page type over OpenRegister's one native flow store (ADR-065), scoped to this app."
		},
		{
			"id": "FlowDetail",
			"route": "/flows/:id",
			"type": "flow-detail",
			"title": "Flow",
			"config": { "app": "learniq" },
			"_note": "The shared CnFlowDetail canvas over the same single engine. Controls render in the NC app sidebar so the canvas keeps full width."
		}
	]
}
