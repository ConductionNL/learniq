							],
							"hideEmpty": true
						}
					},
					{
						"id": "board-history-card",
						"type": "audit-trail",
						"title": "Record history",
						"icon": "History",
						"content": {
							"excludeActions": [
								"read"
							],
							"maxDisplay": 5,
							"layout": "stacked"
						}
