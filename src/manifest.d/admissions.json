				"follow": false,
				"showWidgetActions": false,
				"layout": [
					{
						"id": "1",
						"widgetId": "board-tabs",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 18,
						"showTitle": false
					}
				]
			}
