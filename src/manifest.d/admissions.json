	"pages": [
		{
			"id": "LearningRecordImportView",
			"route": "/admissions/applications/:applicationId/learning-record-import",
			"type": "custom",
			"title": "Import prior learning record",
			"component": "LearningRecordImportView",
			"_note": "portable-learning-record: coordinator upload + live coverage report for one Application's admissions intake, modeled directly on CoursePackageImportView's upload+live-report shape. Reachable from ApplicationDetail's related-index panel."
		},
		{
			"id": "AdmissionsRounds",
			"route": "/admissions/rounds",
			"type": "index",
			"title": "Admissions rounds",
			"config": {
				"showTitle": true,
				"register": "learniq",
				"schema": "admissions-round"
			}
		},
		{
			"id": "AdmissionsRoundDetail",
			"route": "/admissions/rounds/:id",
			"type": "detail",
			"title": "Admissions round",
			"config": {
				"register": "learniq",
				"schema": "admissions-round",
				"_note": "admissions-and-subject-choice: an AdmissionsRound is the intake norm config per Programme/level + academicYear (kind, applicationDeadline, mandatoryIntake, capacity) -- a config/rule archetype, mirroring BsaTrajectory/AttendanceThreshold. Body leads with the round definition (8-wide) and a Related panel resolving the scoped Programme. The Applications submitted into this round render as a wide related-index so a coordinator sees the round's intake at a glance. No comms leaves (no linkedTypes). Sidebar keeps metadata + audit-trail.",
				"lifecycleActions": {
					"field": "lifecycle"
				},
				"widgets": [
					{
						"id": "ar-data",
						"type": "data",
						"title": "Data",
						"content": {
							"columns": 2
						},
						"icon": "Calendar"
					},
					{
						"id": "ar-applications",
						"type": "object-list",
						"title": "Applications",
						"content": {
							"register": "learniq",
							"schema": "admission",
							"filter": {
								"admissionsRoundId": "@objectId"
							},
							"sort": {
								"field": "submittedAt",
								"dir": "asc"
							},
							"limit": 25,
							"columns": [
								{
									"key": "applicantGivenName",
									"label": "Given name"
								},
								{
									"key": "applicantFamilyName",
									"label": "Family name"
								},
								{
									"key": "lifecycle",
									"label": "State"
								},
								{
									"key": "submittedAt",
									"label": "Submitted"
								}
							]
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "ar-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 6
					},
					{
						"id": "2",
						"widgetId": "ar-applications",
						"gridX": 0,
						"gridY": 6,
						"gridWidth": 12,
						"gridHeight": 6
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "Applications",
			"route": "/admissions/applications",
			"type": "index",
			"title": "Applications",
			"config": {
				"headerButtons": [
					{
						"action": "export",
						"label": "Download",
						"icon": "TrayArrowDown"
					},
					{
						"action": "add",
						"label": "New application",
						"variant": "primary",
						"icon": "Plus"
					}
				],
				"showTitle": true,
				"register": "learniq",
				"schema": "admission"
			}
		},
		{
			"id": "ApplicationDetail",
			"route": "/admissions/applications/:id",
			"type": "detail",
			"title": "Application",
			"config": {
				"register": "learniq",
				"schema": "admission",
				"_note": "Board LqCoAanmelding (G2): the application as a card, the school advice as a card, the prior learning records as a tab; round and programme beside it.",
				"lifecycleActions": {
					"field": "lifecycle"
				},
				"statusPill": {
					"field": "lifecycle",
					"labels": {
						"draft": "Draft",
						"submitted": "Submitted",
						"intake-scheduled": "Intake planned",
						"intake-completed": "Intake held",
						"placed": "Placed",
						"waitlisted": "Waiting list",
						"rejected": "Rejected",
						"converted": "Enrolled",
						"withdrawn": "Withdrawn"
					},
					"colorMap": {
						"intake-completed": "purple",
						"placed": "success",
						"converted": "success",
						"rejected": "error",
						"waitlisted": "warning"
					}
				},
				"breadcrumb": {
					"label": "Applications",
					"route": "Applications"
				},
				"headerMeta": "submitted {submittedAt|longdate}",
				"widgets": [
					{
						"id": "app-facts",
						"type": "facts",
						"title": "Application",
						"content": {
							"fields": [
								{
									"path": "applicantGivenName",
									"label": "Given name"
								},
								{
									"path": "applicantFamilyName",
									"label": "Family name"
								},
								{
									"path": "applicantBirthDate",
									"label": "Date of birth",
									"format": "longdate"
								},
								{
									"path": "priorSchool",
									"label": "Previous school"
								},
								{
									"path": "admissionsRoundId",
									"label": "Round",
									"resolve": {
										"register": "learniq",
										"schema": "admissions-round",
										"labelField": "name"
									}
								},
								{
									"path": "programmeId",
									"label": "Programme",
									"resolve": {
										"register": "learniq",
										"schema": "programme",
										"labelField": "name"
									}
								},
								{
									"label": "Parent",
									"parts": [
										{
											"path": "guardianGivenName"
										},
										{
											"path": "guardianFamilyName"
										}
									],
									"separator": " "
								},
								{
									"path": "guardianEmail",
									"label": "Email",
									"format": "email"
								},
								{
									"path": "guardianPhone",
									"label": "Phone",
									"format": "phone"
								},
								{
									"path": "submittedAuthLevel",
									"label": "Login level when submitted",
									"map": {
										"none": "none",
										"basic": "basic",
										"substantial": "substantial (DigiD)",
										"high": "high"
									}
								},
								{
									"path": "intakeScheduledAt",
									"label": "Intake",
									"format": "longdatetime"
								},
								{
									"path": "intakeNotes",
									"label": "Intake note"
								}
							],
							"columns": 2
						}
					},
					{
						"id": "app-advice",
						"type": "facts",
						"title": "School advice",
						"content": {
							"fields": [
								{
									"path": "schoolAdviceLevel",
									"label": "Advice of the primary school",
									"map": {
										"pro": "pro",
										"vmbo-bb": "vmbo-bb",
										"vmbo-kb": "vmbo-kb",
										"vmbo-gt": "vmbo-gt",
										"havo": "havo",
										"vwo": "vwo"
									}
								},
								{
									"path": "progressionTestLevel",
									"label": "Progression test",
									"map": {
										"pro": "pro",
										"vmbo-bb": "vmbo-bb",
										"vmbo-kb": "vmbo-kb",
										"vmbo-gt": "vmbo-gt",
										"havo": "havo",
										"vwo": "vwo"
									}
								},
								{
									"path": "schoolAdviceAdjustedLevel",
									"label": "Adjusted advice",
									"map": {
										"pro": "pro",
										"vmbo-bb": "vmbo-bb",
										"vmbo-kb": "vmbo-kb",
										"vmbo-gt": "vmbo-gt",
										"havo": "havo",
										"vwo": "vwo"
									}
								},
								{
									"path": "adjustmentMotivation",
									"label": "Why it was adjusted"
								},
								{
									"path": "adviesNote",
									"label": "Placement"
								}
							],
							"columns": 2
						}
					},
					{
						"id": "app-learning-record-imports",
						"type": "object-list",
						"title": "Prior learning records",
						"icon": "FileDocument",
						"_note": "portable-learning-record: presentation-only related-index panel resolving LearningRecordImport rows uploaded as evidence for this Application. Application's own schema is unchanged.",
						"content": {
							"register": "learniq",
							"schema": "learning-record-import",
							"filter": {
								"applicationId": "@objectId"
							}
						}
					},
					{
						"id": "board-history",
						"type": "audit-trail",
						"title": "Record history",
						"icon": "History",
						"content": {
							"excludeActions": [
