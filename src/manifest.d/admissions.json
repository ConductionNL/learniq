							"layout": "stacked"
						}
					},
					{
						"id": "board-tabs",
						"type": "tabs",
						"title": "Panels",
						"content": {
							"ariaLabel": "Details",
							"tabs": [
								{
									"label": "Overview",
									"widgetIds": [
										"app-facts",
										"app-advice"
									]
								},
								{
									"label": "Prior learning records",
									"widgetId": "app-learning-record-imports"
								},
								{
									"widgetId": "board-history",
									"label": "Record history"
								}
							]
						}
					}
				],
				"sideColumn": [
					{
						"id": "app-linked",
						"type": "facts",
						"title": "Linked",
						"content": {
							"fields": [
								{
									"path": "admissionsRoundId",
									"label": "Round",
									"resolve": {
										"register": "learniq",
										"schema": "admissions-round",
										"labelField": "name"
									}
								},
								{
									"path": "programmeId",
									"label": "Programme",
									"resolve": {
