		{
			"id": "AdmissionsReviewBoard",
			"route": "/admissions/review-board",
			"type": "custom",
			"title": "Admissions review board",
			"component": "AdmissionsReviewBoard",
			"_note": "admissions-and-subject-choice (task 5.2): the one genuine custom-view exception for admissions -- a coordinator's queue of Applications in intake-completed needing a decision, cross-referencing each Application against its round's deadline, kind, and remaining capacity (a join a generic list widget cannot express), with a link to record the decision. Every other Application/AdmissionsRound screen is a declarative manifest index/detail page."
		},
		{
			"id": "SchoolAdviezen",
			"route": "/admissions/schooladviezen",
			"type": "index",
			"title": "School advies",
			"config": {
				"showTitle": true,
				"register": "learniq",
				"schema": "school-advies",
				"columns": [
					{
						"key": "learnerId",
						"label": "Learner",
