	"pages": [
		{
			"id": "ConferenceRounds",
			"route": "/conferences/rounds",
			"type": "index",
			"title": "Conference rounds",
			"config": {
				"register": "learniq",
				"schema": "conference-round"
			}
		},
		{
			"id": "ConferenceRoundDetail",
			"route": "/conferences/rounds/:id",
			"type": "detail",
			"title": "Conference round",
			"config": {
				"register": "learniq",
				"schema": "conference-round",
				"_note": "A ConferenceRound is one oudergesprekken-cyclus for a report period — an event/cycle archetype (scope, timing, booking window, invited learners). Body leads with round details (8-wide) and a Related panel. The generated ConferenceSlots for the round render as a wide related-index (the schedule). lifecycleActions expose send-invitations/open-booking/close-booking/generate/regenerate/complete/cancel as buttons. Sidebar keeps metadata + audit-trail.",
				"lifecycleActions": {
					"field": "lifecycle"
				},
				"widgets": [
					{
						"id": "round-data",
						"type": "data",
						"title": "Data",
						"content": {
							"columns": 2
						},
						"icon": "Calendar"
					},
					{
						"id": "round-slots",
						"type": "object-list",
						"title": "Conference slots",
						"content": {
							"register": "learniq",
							"schema": "conference-slot",
							"filter": {
								"conferenceRoundId": "@object.id"
							},
							"sort": {
								"field": "startsAt",
								"dir": "asc"
							},
							"limit": 50,
							"columns": [
								{
									"key": "teacherId",
									"label": "Teacher"
								},
								{
									"key": "learnerId",
									"label": "Learner"
								},
								{
									"key": "startsAt",
									"label": "Starts"
								},
								{
									"key": "endsAt",
									"label": "Ends"
								},
								{
									"key": "lifecycle",
									"label": "Status"
								}
							],
							"rowRoute": "ConferenceSlotDetail",
							"viewAllRoute": "ConferenceSlots",
							"viewAllQuery": {
								"conferenceRoundId": "@object.id"
							},
							"emptyText": "No conference slots generated yet.",
							"allowCreate": false
						},
						"icon": "CheckCircleOutline"
					},
					{
						"id": "round-related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "round-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 5,
						"showTitle": false
					},
					{
						"id": "2",
						"widgetId": "round-related",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 5,
						"showTitle": false
					},
					{
						"id": "3",
						"widgetId": "round-slots",
						"gridX": 0,
						"gridY": 5,
						"gridWidth": 12,
						"gridHeight": 5,
						"showTitle": false
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
