								"admin",
								"administration-manager"
							]
						}
					}
				},
				{
					"id": "DossierReviewsMenu",
					"label": "Parent reviews",
					"icon": "FileAccountOutline",
					"route": "DossierReviews",
					"order": 30,
					"visibleIf": {
						"user.primaryRole": {
							"in": [
								"admin",
								"administration-manager"
							]
						}
					}
				},
				{
					"id": "TeldatumChecksMenu",
					"label": "Teldatum checks",
					"icon": "CalendarCheckOutline",
					"route": "TeldatumChecks",
					"order": 40,
					"visibleIf": {
						"user.primaryRole": {
							"in": [
								"admin",
								"administration-manager"
							]
						}
					}
				},
				{
					"id": "ImportExportToolsMenu",
					"label": "Import & export",
					"icon": "DatabaseExportOutline",
					"route": "RequestExportModal",
					"order": 50,
					"visibleIf": {
						"user.primaryRole": {
							"in": [
								"admin",
