		{
			"id": "DataExchangeJobDetail",
			"route": "/data-exchange/jobs/:id",
			"type": "detail",
			"title": "Data exchange job",
			"config": {
				"register": "learniq",
				"schema": "data-exchange-job",
				"_note": "A Data Exchange Job is a single import/export run (direction, target, mapping profile, scope, format, timing, result, connector run, error) — a technical/run-log archetype. Body leads with the job data including result and error message (8-wide) and a Related panel resolving the mapping profile, requester and originating flag. The result payload/log renders as a Files leaf. NO comms leaves (machine job, not correspondence). Sidebar keeps metadata + audit-trail.",
				"lifecycleActions": {
					"field": "lifecycle"
				},
				"widgets": [
					{
						"id": "dej-data",
						"type": "data",
						"title": "Data",
						"content": {
							"columns": 2
						},
						"icon": "DatabaseOutline"
					},
					{
						"id": "dej-related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant"
					},
					{
						"id": "dej-files",
						"type": "integration",
						"integrationId": "files",
						"title": "Job payload & logs",
						"icon": "FolderOutline"
					},
					{
						"id": "dej-rejections",
						"type": "object-list",
						"title": "Rejections",
						"content": {
							"register": "learniq",
							"schema": "exchange-rejection",
							"filter": {
								"dataExchangeJobId": "@objectId"
							},
							"sort": {
								"field": "detectedAt",
								"dir": "desc"
							},
							"limit": 25,
							"columns": [
								{
									"key": "errorCode",
									"label": "Error Code"
								},
								{
									"key": "sourceKind",
									"label": "Source Kind"
								},
								{
									"key": "status",
									"label": "Status"
								},
								{
									"key": "detectedAt",
									"label": "Detected At"
								}
							],
							"rowRoute": "ExchangeRejectionDetail",
							"viewAllRoute": "ExchangeRejections",
							"viewAllQuery": {
								"dataExchangeJobId": "@objectId"
							},
							"emptyText": "No rejections found for this job.",
							"allowCreate": false
						},
						"icon": "AlertCircleOutline"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "dej-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 5,
						"showTitle": false
					},
					{
						"id": "2",
						"widgetId": "dej-related",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 5,
						"showTitle": false
					},
					{
						"id": "3",
						"widgetId": "dej-files",
						"gridX": 0,
						"gridY": 5,
						"gridWidth": 12,
						"gridHeight": 3,
						"showTitle": false
					},
					{
						"id": "4",
						"widgetId": "dej-rejections",
						"gridX": 0,
						"gridY": 8,
						"gridWidth": 12,
						"gridHeight": 5,
						"showTitle": false
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
