			"id": "GroupDataExchange",
			"label": "Data exchange",
			"icon": "DatabaseOutline",
			"order": 31,
			"children": [
				{
					"id": "ExchangeJobsMenu",
					"label": "Exchange jobs",
					"icon": "ShareVariant",
					"route": "ExchangeJobs",
					"order": 10,
					"visibleIf": {
						"user.primaryRole": {
							"in": [
								"admin",
								"administration-manager"
							]
