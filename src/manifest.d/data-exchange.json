				"schema": "exchange-rejection"
			}
		},
		{
			"id": "ExchangeRejectionDetail",
			"route": "/data-exchange/rejections/:id",
			"type": "detail",
			"title": "Exchange rejection",
			"config": {
				"register": "learniq",
				"schema": "exchange-rejection",
				"_note": "An Exchange Rejection is a single afkeurmelding — DUO's (or any target's) refusal of one exported record, resolved back to its Learniq source object via sourceKind + a typed $ref id field — the correction-loop worklist entry. Body leads with the rejection data (error code/message, age) (8-wide) and a Related panel that auto-resolves the originating DataExchangeJob AND whichever sourceKind $ref field is set (learnerProfileId/enrolmentId/finalGradeId/attendanceFlagId/supportRequestId) into a deep link to the offending object's own editable detail page — the whole point of this page (design.md 'sourceKind enum + per-kind typed $ref'). lifecycleActions renders Mark corrected/Resubmit/Waive from the declared lifecycle. NO comms leaves (no linkedTypes). Sidebar keeps metadata + audit-trail.",
				"lifecycleActions": {
					"field": "status"
				},
				"widgets": [
					{
						"id": "erej-data",
						"type": "data",
						"title": "Data",
						"content": {
							"columns": 2
						},
						"icon": "AlertCircleOutline"
					},
					{
						"id": "erej-related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "erej-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 5,
						"showTitle": false
					},
					{
						"id": "2",
						"widgetId": "erej-related",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 5,
						"showTitle": false
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "ExchangeErrorCodes",
			"route": "/data-exchange/error-codes",
			"type": "index",
			"title": "Exchange error codes",
			"config": {
				"register": "learniq",
				"schema": "exchange-error-code"
			}
		},
		{
			"id": "ExchangeErrorCodeDetail",
			"route": "/data-exchange/error-codes/:id",
			"type": "detail",
			"title": "Exchange error code",
			"config": {
				"register": "learniq",
				"schema": "exchange-error-code",
				"_note": "An Exchange Error Code is a local, admin-editable reference-data catalogue entry (code, target, bilingual description, category, severity, active) used by RejectionMappingHandler to best-effort resolve ExchangeRejection.errorCodeRef — explicitly illustrative starter data, not DUO's authoritative list (design.md). Body is the data block only (8-wide) — reference data has no Related panel and no lifecycleActions beyond the register's own default create/edit. Sidebar keeps metadata + audit-trail.",
				"widgets": [
					{
						"id": "eec-data",
						"type": "data",
						"title": "Data",
						"content": {
							"columns": 2
						},
						"icon": "BookOpenVariant"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "eec-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 5,
						"showTitle": false
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
