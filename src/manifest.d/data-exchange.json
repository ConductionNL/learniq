			"config": {
				"register": "learniq",
				"schema": "dossier-review",
				"_note": "A parent's decision on one OSO or SWV file before integriq sends it (data-exchange-to-integriq). Approve and Reject come from the declared lifecycle; OsoDossierReviewGuard lets only a parent of the learner decide. Replaces the OsoDossierReviewView custom page.",
				"lifecycleActions": {
					"field": "status"
				},
