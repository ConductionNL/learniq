	"pages": [
		{
			"id": "ExchangeJobs",
			"route": "/data-exchange/jobs",
			"type": "index",
			"title": "Exchange jobs",
			"requiresApp": {
				"id": "integriq",
				"name": "Integriq"
			},
			"config": {
				"register": "integriq",
				"schema": "job",
				"filter": {
					"ownerApp": "learniq"
				},
				"showViewAction": false,
				"_note": "data-exchange-to-integriq (D7): the exchange jobs integriq carries for learniq, read-only. Integriq's job rows hold no personal data (integriq design D3). Why a job waits is at GET /api/exchange-gates/{jobId}; correcting a rejection is integriq's resubmit and waive.",
				"defaultSort": {
					"field": "requestedAt",
					"direction": "desc"
				},
				"columns": [
					{
						"key": "name",
						"label": "Job"
					},
					{
						"key": "exchangeTarget",
						"label": "Target"
					},
					{
						"key": "exchangeDirection",
						"label": "Direction"
					},
					{
						"key": "exchangeStatus",
						"label": "Status"
					},
					{
						"key": "requestedAt",
						"label": "Requested"
					},
					{
						"key": "finishedAt",
						"label": "Finished"
					},
					{
						"key": "exchangeError",
						"label": "Error",
						"sortable": false
					}
				],
				"selectable": false,
				"showAdd": false,
				"showFormDialog": false,
				"showEditAction": false,
				"showCopyAction": false,
				"showDeleteAction": false,
				"showMassImport": false,
				"showMassCopy": false,
				"showMassDelete": false
			}
		},
		{
			"id": "ExchangeRejections",
			"route": "/data-exchange/rejections",
			"type": "index",
			"title": "Rejections",
			"requiresApp": {
				"id": "integriq",
				"name": "Integriq"
			},
			"config": {
				"register": "integriq",
				"schema": "sync_item_dead_letter",
				"filter": {
					"ownerApp": "learniq"
				},
				"showViewAction": false,
				"_note": "data-exchange-to-integriq (D7): records a target rejected, as integriq dead letters owned by learniq, read-only. Each names the learniq record by owner reference, never its data. Fix the record in learniq, then resubmit in integriq.",
				"columns": [
					{
						"key": "exchangeTarget",
						"label": "Target"
					},
					{
						"key": "errorCode",
						"label": "Code"
					},
					{
						"key": "error",
						"label": "What went wrong",
						"sortable": false
					},
					{
						"key": "ownerRef",
						"label": "Record"
					},
					{
						"key": "status",
						"label": "Status"
					}
				],
				"selectable": false,
				"showAdd": false,
				"showFormDialog": false,
				"showEditAction": false,
				"showCopyAction": false,
				"showDeleteAction": false,
				"showMassImport": false,
				"showMassCopy": false,
				"showMassDelete": false
			}
		},
		{
			"id": "DossierReviews",
			"route": "/data-exchange/parent-reviews",
