	"pages": [
		{
			"id": "DataMappingProfiles",
			"route": "/data-exchange/mapping-profiles",
			"type": "index",
			"title": "Data mapping profiles",
			"config": {
				"register": "learniq",
				"schema": "data-mapping-profile"
			}
		},
		{
			"id": "DataMappingProfileDetail",
			"route": "/data-exchange/mapping-profiles/:id",
			"type": "detail",
			"title": "Data mapping profile",
			"config": {
				"register": "learniq",
				"schema": "data-mapping-profile",
				"_note": "A Data Mapping Profile is an integration config (target, direction, source/target schema, field mappings, validation) for data exchange — a technical/config archetype. Body leads with the profile definition including field mappings (8-wide) and a Related panel. The Data exchange jobs run against this profile render as a wide related-index (the run log). NO comms leaves — this is machine config, not correspondence (HARD RULE 1). Sidebar keeps metadata + audit-trail.",
				"lifecycleActions": {
					"field": "lifecycle"
				},
				"widgets": [
					{
						"id": "dmp-data",
						"type": "data",
						"title": "Data",
						"content": {
							"columns": 2
						},
						"icon": "Sitemap"
					},
					{
						"id": "dmp-kpis",
						"type": "stats-block",
						"title": "Overview",
						"icon": "ChartBar",
						"content": {
							"entries": [
								{
									"title": "Exchange jobs",
									"register": "learniq",
									"schema": "data-exchange-job",
									"metric": "count",
									"filter": {
										"mappingProfileId": "@objectId"
									},
									"route": "DataExchangeJobs"
								}
							]
						}
					},
					{
						"id": "dmp-jobs",
						"type": "object-list",
						"title": "Exchange jobs",
						"content": {
							"register": "learniq",
							"schema": "data-exchange-job",
							"filter": {
								"mappingProfileId": "@objectId"
							},
							"sort": {
								"field": "id",
								"dir": "asc"
							},
							"limit": 25,
							"columns": [
								{
									"key": "direction",
									"label": "Direction"
								},
								{
									"key": "target",
									"label": "Target"
								},
								{
									"key": "requestedAt",
									"label": "Requested At"
								},
								{
									"key": "result",
									"label": "Result"
								}
							],
							"rowRoute": "DataExchangeJobDetail",
							"viewAllRoute": "DataExchangeJobs",
							"viewAllQuery": {
								"mappingProfileId": "@objectId"
							},
							"emptyText": "No exchange jobs found.",
							"allowCreate": false
						},
						"icon": "DatabaseOutline"
					},
					{
						"id": "dmp-related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "dmp-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 5,
						"showTitle": false
					},
					{
						"id": "2",
						"widgetId": "dmp-kpis",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 5,
						"showTitle": false
					},
					{
						"id": "3",
						"widgetId": "dmp-jobs",
						"gridX": 0,
						"gridY": 5,
						"gridWidth": 6,
						"gridHeight": 5,
						"showTitle": false
					},
					{
						"id": "4",
						"widgetId": "dmp-related",
						"gridX": 6,
						"gridY": 5,
						"gridWidth": 6,
						"gridHeight": 5,
						"showTitle": false
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "DataExchangeJobs",
			"route": "/data-exchange/jobs",
			"type": "index",
			"title": "Data exchange jobs",
			"config": {
				"register": "learniq",
				"schema": "data-exchange-job"
			}
