			"type": "detail",
			"title": "Dossier note",
			"config": {
				"register": "learniq",
				"schema": "dossier-note",
				"_note": "Board LqNotitie (G2): the note text first under a notice that a dossier note is not changed, then its facts; who may read it as a header pill. Read-only, so no inline editors.",
				"readOnly": true,
				"statusPill": {
					"field": "confidentiality",
					"labels": {
						"team-visible": "The team",
						"care-team-only": "Only the care team",
						"private-to-author": "Only me"
					},
					"colorMap": {
						"care-team-only": "warning",
						"private-to-author": "warning"
					}
				},
				"typePill": {
					"field": "category",
					"labels": {
						"observation": "Observation",
						"conversation": "Conversation",
						"phone-call-home": "Phone call home",
						"concern": "Care",
						"positive": "Positive"
					},
					"colorMap": {
						"concern": "warning",
						"positive": "success"
					}
				},
				"breadcrumb": {
					"label": "Dossier notes",
					"route": "DossierNotes"
				},
				"headerMeta": "written by {authorId|user} on {date|longdate}",
				"widgets": [
					{
						"id": "dn-body",
						"type": "facts",
						"title": "Note",
						"content": {
							"fields": [
								{
									"as": "text",
									"path": "body"
								}
							],
							"notice": {
								"text": "A dossier note is no longer changed. If something is wrong, write a new note that adds to it."
							}
						}
					},
					{
						"id": "dn-facts",
						"type": "facts",
						"title": "Details",
						"content": {
							"fields": [
								{
									"path": "learnerId",
									"label": "Learner",
									"format": "user"
								},
								{
									"path": "date",
									"label": "Date",
									"format": "longdate"
								},
								{
									"path": "category",
									"label": "Kind",
									"map": {
										"observation": "Observation",
										"conversation": "Conversation",
										"phone-call-home": "Phone call home",
										"concern": "Care",
										"positive": "Positive"
									}
								},
								{
									"path": "confidentiality",
									"label": "Who can see it",
									"map": {
										"team-visible": "The team",
										"care-team-only": "Only the care team",
										"private-to-author": "Only me"
									}
								},
								{
									"path": "authorId",
									"label": "Author",
									"format": "user"
								},
								{
									"path": "careTeamUserIds",
									"label": "Care team",
									"format": "list"
								}
							],
							"columns": 2
						}
					},
					{
						"id": "board-history",
						"type": "audit-trail",
						"title": "Record history",
						"icon": "History",
						"content": {
