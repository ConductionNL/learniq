		{
			"id": "BehaviourIncidentDetail",
			"route": "/pupil-dossier/incidents/:id",
			"type": "detail",
			"title": "Behaviour incident",
			"config": {
				"register": "learniq",
				"schema": "behaviour-incident",
				"_note": "pupil-dossier-notes: a BehaviourIncident is what/where/who-involved, severity, an append-only followUpActions log, and an eventual resolution — own lifecycle open -> in-handling -> resolved, no guard on either transition (mirrors AttendanceThreshold's own unguarded activate/archive). Optionally references a SupportRequest (escalatedSupportRequestId) when staff raise a formal zorgvraag from it; the incident never duplicates SupportRequest fields, it only points at one. Body leads with the incident data (8-wide) and a Related panel resolving the escalated SupportRequest, if any. No comms leaves (no linkedTypes). Sidebar keeps metadata + audit-trail.",
				"lifecycleActions": {
					"field": "lifecycle"
				},
