			"type": "detail",
			"title": "BSA trajectory",
			"config": {
				"register": "learniq",
				"schema": "bsa-trajectory",
				"_note": "bsa-study-progress-guard: a BsaTrajectory is the BSA norm config per Programme + academicYear (kind, normEcts, interim-check window, onAtRisk action) — a config/rule archetype, mirroring AttendanceThreshold. Body leads with the rule definition (8-wide) and a Related panel resolving the scoped Programme/Cohort. The BsaProgressFlags this rule has raised render as a wide related-index so a study-advisor sees its effect. No comms leaves (no linkedTypes). Sidebar keeps metadata + audit-trail for rule-change history.",
				"lifecycleActions": {
					"field": "lifecycle"
				},
				"widgets": [
					{
						"id": "bt-data",
						"type": "data",
						"title": "Data",
						"content": {
							"columns": 2
						},
						"icon": "ScaleBalance"
					},
					{
						"id": "bt-kpis",
						"type": "stats-block",
						"title": "Overview",
						"icon": "ChartBar",
						"content": {
							"entries": [
								{
									"title": "Raised flags",
									"register": "learniq",
									"schema": "bsa-progress-flag",
									"metric": "count",
									"filter": {
										"bsaTrajectoryId": "@objectId"
									},
									"route": "BsaProgressFlags"
								}
							]
						}
					},
					{
						"id": "bt-flags",
						"type": "object-list",
						"title": "Raised flags",
						"content": {
							"register": "learniq",
							"schema": "bsa-progress-flag",
							"filter": {
								"bsaTrajectoryId": "@objectId"
							},
							"sort": {
								"field": "flaggedAt",
								"dir": "desc"
							},
							"limit": 25,
							"columns": [
								{
									"key": "learnerId",
									"label": "Learner ID"
								},
								{
									"key": "ectsEarned",
									"label": "Credits Earned (EC)"
								},
								{
									"key": "ectsRequiredAtCheck",
									"label": "Credits Required (EC)"
								},
								{
									"key": "flaggedAt",
									"label": "Flagged At"
								}
							],
							"rowRoute": "BsaProgressFlagDetail",
							"viewAllRoute": "BsaProgressFlags",
							"viewAllQuery": {
								"bsaTrajectoryId": "@objectId"
							},
							"emptyText": "No raised flags found.",
							"allowCreate": false
						},
						"icon": "AlertCircleOutline"
					},
					{
						"id": "bt-related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant"
					}
