{
	"_meta": {
		"spdx-license": "EUPL-1.2",
		"spdx-copyright": "2026 Conduction B.V.",
		"change": "payments-to-shillinq-migration",
		"adr": "ADR-037 modular manifest fragment — never edit src/manifest.json",
		"description": "FeeItem and Entitlement: what a school charges and what a paid, non-voluntary fee grants. payments-to-shillinq-migration (D19) retired Order, OrderLine, PaymentTransaction, the pay screen and the Payments group: a school charges through shillinq and the pay screen is portaliq's. The two remaining entries are relocated under People by src/menu-layout.json."
	},
	"menu": [
		{
			"id": "FeeItemsMenu",
			"label": "Fee items",
			"icon": "CurrencyEur",
			"route": "FeeItems",
			"order": 20,
			"visibleIf": {
				"user.primaryRole": {
					"in": [
						"admin"
					]
				}
			}
		},
		{
			"id": "EntitlementsMenu",
			"label": "Entitlements",
			"icon": "Check",
			"route": "Entitlements",
			"order": 49,
			"visibleIf": {
				"user.primaryRole": {
					"in": [
						"admin"
					]
				}
			}
		}
	],
	"pages": [
		{
			"id": "FeeItems",
			"route": "/payments/fee-items",
			"type": "index",
			"title": "Fee items",
			"config": {
				"showTitle": true,
				"breadcrumb": [
					{
						"label": "Payments"
					},
					{
						"label": "School costs"
					}
				],
				"register": "learniq",
				"schema": "fee-item"
			}
		},
		{
			"id": "FeeItemDetail",
			"route": "/payments/fee-items/:id",
			"type": "detail",
			"title": "Fee item",
			"config": {
				"register": "learniq",
				"schema": "fee-item",
				"_note": "Board LqSchoolkosten (G2): the fee as a card with the voluntary notice, linked groups and course beside it. The contributions per learner (from shillinq) wait on lane E.",
				"headerActions": [
					{
						"id": "raise-contributions",
						"label": "Raise contributions in shillinq",
						"type": "api-call",
						"url": "/apps/learniq/api/fee-items/@objectId/contributions",
						"method": "POST",
						"confirm": true,
						"icon": "CurrencyEur",
						"successMessage": "The contributions were sent to shillinq.",
						"errorMessage": "The contributions could not be raised in shillinq.",
						"visibleWhen": {
							"field": "lifecycle",
							"op": "eq",
							"value": "active"
						}
					}
				],
				"statusPill": {
					"field": "lifecycle",
					"labels": {
						"draft": "Draft",
						"active": "Active",
						"archived": "Archived"
					},
					"colorMap": {
						"active": "success"
					}
				},
				"typePill": {
					"field": "voluntary",
					"labels": {
						"true": "Voluntary"
					},
					"colorMap": {
						"true": "teal"
					},
					"values": [
						"true"
					]
				},
				"breadcrumb": {
					"label": "Fee items",
					"route": "FeeItems"
				},
				"headerMeta": "{amount|currency} per learner",
				"widgets": [
					{
						"id": "fee-facts",
						"type": "facts",
						"title": "Details",
						"content": {
							"fields": [
								{
									"path": "name",
									"label": "Name"
								},
								{
									"path": "kind",
									"label": "Kind",
									"map": {
										"course-enrolment": "Course fee",
										"school-trip": "School trip",
										"materials": "Materials",
										"schoolkassa": "School fund",
										"mbo-contractonderwijs": "Contract education",
										"other": "Other"
									}
								},
								{
									"path": "amount",
									"label": "Amount",
									"format": "currency",
									"suffix": " per learner"
								},
								{
									"path": "voluntary",
									"label": "Voluntary",
									"map": {
										"true": "Yes, a voluntary parental contribution",
										"false": "No, required to take part"
									}
								},
								{
									"path": "linkedCohortId",
									"label": "Group",
									"resolve": {
										"register": "learniq",
										"schema": "Cohort",
										"labelField": "name"
									}
								},
								{
									"path": "academicYear",
									"label": "Academic year"
								},
								{
									"path": "validFrom",
									"label": "Collect from",
									"format": "longdate"
								},
								{
									"path": "validUntil",
									"label": "Collect until",
									"format": "longdate"
								},
								{
									"path": "taxPosture",
									"label": "VAT",
									"map": {
										"education-exempt": "Exempt, education",
										"standard-rate": "Standard rate",
										"reduced-rate": "Reduced rate",
										"not-applicable": "Not applicable"
									}
								},
								{
									"path": "description",
									"label": "Description"
								},
								{
									"as": "line",
									"text": "This contribution is voluntary. Whether parents pay is shown for information only: every learner takes part, also when nothing was paid.",
									"when": {
										"field": "voluntary",
										"op": "eq",
										"value": true
									}
								}
							],
							"columns": 2
						}
					}
				],
				"sideColumn": [
					{
						"id": "fee-linked",
						"type": "facts",
						"title": "Linked",
						"content": {
							"fields": [
								{
									"path": "linkedCohortId",
									"label": "Group",
									"resolve": {
										"register": "learniq",
										"schema": "Cohort",
										"labelField": "name"
									},
									"route": {
										"name": "CohortDetail",
										"params": {
											"id": "@source.linkedCohortId"
										}
									}
								},
								{
									"path": "linkedCourseId",
									"label": "Course",
									"resolve": {
										"register": "learniq",
										"schema": "Course",
										"labelField": "name"
									},
									"route": {
										"name": "CourseDetail",
										"params": {
											"id": "@source.linkedCourseId"
										}
									}
								}
							],
							"hideEmpty": true
						}
					}
				],
				"board": {
					"tabs": [
						{
							"label": "Overview",
							"widgetIds": [
								"fee-facts"
							]
						}
					]
				}
			},
			"_note": "payments-to-shillinq-migration (D19): the Raise contributions action posts to ContributionController, which raises this fee's contributions in shillinq for the guardians of its learners (shillinq contract extracurricular-fee-to-shillinq v1). Visible on an active fee only."
		},
		{
			"id": "Entitlements",
			"route": "/payments/entitlements",
			"type": "index",
			"title": "Entitlements",
			"config": {
				"showTitle": true,
				"breadcrumb": [
					{
						"label": "Payments"
					},
					{
						"label": "School costs"
					}
				],
				"register": "learniq",
				"schema": "entitlement",
				"columns": [
					{
						"key": "learnerId",
						"label": "Learner",
						"widget": "learnerName"
					},
					"feeItemId",
					"grantedAt",
					"grantedResourceId",
					"grantedResourceKind",
					"lifecycle",
					"paymentRequestRef",
					"paymentSettledAt",
					"paymentSettledVia"
				]
			}
		},
		{
			"id": "EntitlementDetail",
			"route": "/payments/entitlements/:id",
			"type": "detail",
			"title": "Entitlement",
			"config": {
				"register": "learniq",
				"schema": "entitlement",
				"widgets": [
					{
						"id": "entitlement-data",
						"type": "data",
						"title": "Data",
						"content": {
							"columns": 2
						},
						"icon": "CheckCircleOutline"
					},
					{
						"id": "entitlement-related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "entitlement-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 5,
						"showTitle": false
					},
					{
						"id": "2",
						"widgetId": "entitlement-related",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 5,
						"showTitle": false
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				}
			}
		}
	]
}
