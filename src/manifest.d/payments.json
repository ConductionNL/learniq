{
	"_meta": {
		"spdx-license": "EUPL-1.2",
		"spdx-copyright": "2026 Conduction B.V.",
		"change": "payments-to-shillinq-migration",
		"adr": "ADR-037 modular manifest fragment — never edit src/manifest.json",
		"description": "FeeItem and Entitlement: what a school charges and what a paid, non-voluntary fee grants. payments-to-shillinq-migration (D19) retired Order, OrderLine, PaymentTransaction, the pay screen and the Payments group: a school charges through shillinq and the pay screen is portaliq's. The two remaining entries are relocated under People by src/menu-layout.json."
	},
	"menu": [
		{
			"id": "FeeItemsMenu",
			"label": "Fee items",
			"icon": "CurrencyEur",
			"route": "FeeItems",
			"order": 20,
			"visibleIf": {
				"user.primaryRole": {
					"in": [
						"admin"
					]
				}
			}
		},
		{
			"id": "EntitlementsMenu",
			"label": "Entitlements",
			"icon": "Check",
			"route": "Entitlements",
			"order": 50,
			"visibleIf": {
				"user.primaryRole": {
					"in": [
						"admin"
					]
				}
			}
		}
	],
	"pages": [
		{
			"id": "FeeItems",
			"route": "/payments/fee-items",
			"type": "index",
			"title": "Fee items",
			"config": {
				"register": "learniq",
				"schema": "fee-item"
			}
		},
		{
			"id": "FeeItemDetail",
			"route": "/payments/fee-items/:id",
			"type": "detail",
			"title": "Fee item",
			"config": {
				"register": "learniq",
				"schema": "fee-item",
				"headerActions": [
					{
						"id": "raise-contributions",
						"label": "Raise contributions in shillinq",
						"type": "api-call",
						"url": "/apps/learniq/api/fee-items/@objectId/contributions",
						"method": "POST",
						"confirm": true,
						"icon": "CurrencyEur",
						"successMessage": "The contributions were sent to shillinq.",
						"errorMessage": "The contributions could not be raised in shillinq.",
						"visibleWhen": {
							"field": "lifecycle",
							"op": "eq",
							"value": "active"
						}
					}
				],
				"widgets": [
					{
						"id": "fee-item-data",
						"type": "data",
						"title": "Data",
						"content": {
							"columns": 2
						},
						"icon": "CurrencyEur"
					},
					{
						"id": "fee-item-related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "fee-item-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 5,
						"showTitle": false
					},
					{
						"id": "2",
						"widgetId": "fee-item-related",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 5,
						"showTitle": false
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				}
			},
			"_note": "payments-to-shillinq-migration (D19): the Raise contributions action posts to ContributionController, which raises this fee's contributions in shillinq for the guardians of its learners (shillinq contract extracurricular-fee-to-shillinq v1). Visible on an active fee only."
		},
		{
			"id": "Entitlements",
			"route": "/payments/entitlements",
			"type": "index",
			"title": "Entitlements",
			"config": {
				"register": "learniq",
				"schema": "entitlement"
			}
		},
		{
			"id": "EntitlementDetail",
			"route": "/payments/entitlements/:id",
			"type": "detail",
			"title": "Entitlement",
			"config": {
				"register": "learniq",
				"schema": "entitlement",
				"widgets": [
					{
						"id": "entitlement-data",
						"type": "data",
						"title": "Data",
						"content": {
							"columns": 2
						},
						"icon": "CheckCircleOutline"
					},
					{
						"id": "entitlement-related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "entitlement-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 5,
						"showTitle": false
					},
					{
						"id": "2",
						"widgetId": "entitlement-related",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 5,
						"showTitle": false
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				}
			}
		}
	]
}
