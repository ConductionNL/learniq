		{
			"id": "EnrolmentDetail",
			"route": "/enrolments/:id",
			"type": "detail",
			"title": "Enrolment",
			"_note": "An Enrolment links one learner to one course (learnerId, courseId, cohortId, mandatory flag, dueDate, source, manager, regulation) — the education enrolment/participation archetype. Body leads with enrolment metadata 8-wide with a Related panel resolving learner + course + cohort. The enrolment's academic footprint is surfaced as related-index tables filtered by learnerId + courseId: Grade entries, Submissions and Attendance records — the progress a coordinator checks on this enrolment. No email/calendar: the Enrolment schema declares no linkedTypes; learner correspondence belongs on the Learner profile, not on a join record (HARD RULE 1). Sidebar keeps metadata + audit-trail (enrolment source/mandate changes are compliance-relevant).",
			"config": {
				"register": "learniq",
				"schema": "Enrolment",
				"lifecycleActions": {
					"field": "lifecycle"
				},
				"widgets": [
					{
						"id": "enrol-data",
						"type": "data",
						"title": "Enrolment",
						"content": {
							"columns": 2,
							"include": [
								"learnerId",
								"learnerRef",
								"courseId",
								"cohortId",
								"managerId"
							]
						},
						"icon": "AccountGroup"
					},
					{
						"id": "enrol-details2",
						"type": "data",
						"title": "Progress & logistics",
						"icon": "ChartLine",
						"content": {
							"columns": 2,
							"include": [
								"mandatory",
								"dueDate",
								"source",
								"reason",
								"regulationSlug",
								"bulkJobId"
							]
						}
					},
					{
						"id": "enrol-kpis-grade-entries",
						"type": "stats-block",
						"title": "Grade entries",
						"icon": "ChartBar",
						"content": {
							"entries": [
								{
									"title": "Grade entries",
									"register": "learniq",
									"schema": "grade-entry",
									"metric": "count",
									"filter": {
										"learnerId": "@object.learnerId",
										"courseId": "@object.courseId"
									},
									"route": "GradeEntries"
								}
							]
						}
					},
					{
						"id": "enrol-kpis-attendance-records",
						"type": "stats-block",
						"title": "Attendance records",
						"icon": "ChartBar",
						"content": {
							"entries": [
								{
									"title": "Attendance records",
									"register": "learniq",
									"schema": "attendance-record",
									"metric": "count",
									"filter": {
										"learnerId": "@object.learnerId",
										"courseId": "@object.courseId"
									},
									"route": "AttendanceRecords"
								}
							]
						}
					},
					{
						"id": "enrol-grades",
						"type": "object-list",
						"title": "Grade entries",
						"content": {
							"register": "learniq",
							"schema": "grade-entry",
							"filter": {
								"learnerId": "@object.learnerId",
								"courseId": "@object.courseId"
							},
							"sort": {
								"field": "id",
								"dir": "asc"
							},
							"limit": 25,
							"columns": [
								{
									"key": "componentId",
									"label": "Component ID"
								},
								{
									"key": "sourceKind",
									"label": "Source Kind"
								},
								{
									"key": "value",
									"label": "Value"
								},
								{
									"key": "period",
									"label": "Period"
								},
								{
									"key": "gradedAt",
									"label": "Graded At"
								}
							],
							"rowRoute": "GradeEntryDetail",
							"viewAllRoute": "GradeEntries",
							"viewAllQuery": {
								"learnerId": "@object.learnerId",
								"courseId": "@object.courseId"
							},
							"emptyText": "No grade entries found.",
							"allowCreate": false
						},
						"icon": "Percent"
					},
					{
						"id": "enrol-submissions",
						"type": "object-list",
						"title": "Submissions",
						"content": {
							"register": "learniq",
							"schema": "Submission",
							"filter": {
