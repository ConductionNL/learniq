							"viewAllRoute": "AttendanceRecords",
							"viewAllQuery": {
								"learnerId": "@object.learnerId",
								"courseId": "@object.courseId"
							},
							"emptyText": "No attendance found.",
							"allowCreate": false
						},
						"icon": "CheckCircleOutline"
