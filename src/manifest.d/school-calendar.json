{
	"_meta": {
		"spdx-license": "EUPL-1.2",
		"spdx-copyright": "2026 Conduction B.V.",
		"change": "portal-parent-child-record",
		"adr": "ADR-037 modular manifest fragment, never edit src/manifest.json",
		"description": "SchoolEventsMenu: the school's own calendar (study days, the sports day, trips, celebrations). Coordinators, the school office and the director keep it; parents read it in the portal calendar of their children. Writes are enforced by SchoolEvent.authorization in the register; this gate only hides the entry from everyone else. PermissionRequestsMenu (permission-slips): the school asks guardians for permission and the teacher reads, per request, who answered yes, who answered no and who has not answered. SchoolActivitiesMenu (school-activities-staff-side T1): the staff side of the school's term-long activities (a club, a sport, a trip): places, confirmed sign-ups and the waiting list per activity, read from GET /api/school-activities. The server answers only a holder of the action activity.manage (seed: admin, coordinators, instructors, team-leads), so this gate shows the entry to those roles only."
	},
	"menu": [
		{
			"id": "SchoolEventsMenu",
			"label": "School calendar",
			"icon": "CalendarStar",
			"route": "SchoolEvents",
			"order": 74,
			"visibleIf": {
				"user.primaryRole": {
					"in": [
						"coordinator",
						"administration-manager",
						"team-lead",
						"admin"
					]
				},
				"workspace.chosenSegment": {
					"notIn": [
						"corporate"
					]
				}
			}
		},
		{
			"id": "PermissionRequestsMenu",
			"label": "Permission slips",
			"icon": "FileSignOutline",
			"route": "PermissionRequests",
			"order": 75,
			"visibleIf": {
				"user.primaryRole": {
					"in": [
						"instructor",
						"coordinator",
						"administration-manager",
						"team-lead",
						"admin"
					]
				},
				"workspace.chosenSegment": {
					"notIn": [
						"corporate"
					]
				}
			}
		},
		{
			"id": "SchoolActivitiesMenu",
			"label": "Activities",
			"icon": "Run",
			"route": "SchoolActivities",
			"order": 76,
			"visibleIf": {
				"user.primaryRole": {
					"in": [
						"instructor",
						"coordinator",
						"team-lead",
						"admin"
					]
				},
				"workspace.chosenSegment": {
					"notIn": [
						"corporate"
					]
				}
			}
		}
	],
	"pages": [
		{
			"id": "SchoolEvents",
			"route": "/school-calendar",
			"type": "index",
			"title": "School calendar",
			"config": {
				"showTitle": true,
				"register": "learniq",
				"schema": "school-event",
				"columns": [
					{
						"key": "title",
						"label": "Title"
					},
					{
						"key": "kind",
						"label": "Kind"
					},
					{
						"key": "audience",
						"label": "For"
					},
					{
						"key": "startsAt",
						"label": "Starts",
						"formatter": "date"
					},
					{
						"key": "endsAt",
						"label": "Ends",
						"formatter": "date"
					}
				]
			}
		},
		{
			"id": "SchoolEventDetail",
			"route": "/school-calendar/:id",
			"type": "detail",
			"title": "School event",
			"config": {
				"register": "learniq",
				"schema": "school-event",
				"widgets": [
					{
						"id": "se-data",
						"type": "data",
						"title": "Data",
						"content": {
							"columns": 2
						},
						"icon": "CalendarStar"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "se-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 6,
						"showTitle": false
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "PermissionRequests",
			"route": "/permission-slips",
			"type": "index",
			"title": "Permission slips",
			"config": {
				"showTitle": true,
				"register": "learniq",
				"schema": "permission-request",
				"columns": [
					{
						"key": "title",
						"label": "Title"
					},
					{
						"key": "happensOn",
						"label": "Date",
						"formatter": "date"
					},
					{
						"key": "respondBy",
						"label": "Answer by",
						"formatter": "date"
					},
					{
						"key": "lifecycle",
						"label": "Status"
					}
				]
			}
		},
		{
			"id": "PermissionRequestDetail",
			"route": "/permission-slips/:id",
			"type": "detail",
			"title": "Permission slip",
			"config": {
				"register": "learniq",
				"schema": "permission-request",
				"_note": "permission-slips: one request for permission to the guardians of named learners. The data widget shows what is asked, the date and the deadline; the Answers section lists who answered yes, who answered no and who has not answered, by name, and whether silence counts as no. The close action stops further answers.",
				"lifecycleActions": {
					"field": "lifecycle"
				},
				"widgets": [
					{
						"id": "pr-data",
						"type": "data",
						"title": "Data",
						"content": {
							"columns": 2
						},
						"icon": "FileSignOutline"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "pr-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 6,
						"showTitle": false
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				},
				"bodyWidgets": [
					{
						"id": "pr-outcome",
						"component": "PermissionRequestOutcome",
						"title": "Answers",
						"placement": "after-data",
						"props": {
							"requestId": "@objectId"
						}
					}
				]
			}
		},
		{
			"id": "SchoolActivities",
			"route": "/school-activities",
			"type": "index",
			"title": "Activities",
			"config": {
				"_note": "school-activities-staff-side T1 (board learniq/LqActiviteiten): the activities of the school with their places, confirmed sign-ups and waiting list. The rows come from GET /api/school-activities (SchoolActivityStaff::board()), which reads portaliq's activityOffer and activitySignup records through OpenRegister and answers only a holder of activity.manage. Places are the lower of the capacity and the supervisors times the children per supervisor (ActivityPlaces). A draft activity opens through PUT /api/school-activities/{id}/open, refused with no_places when it has no place. Guardians sign up on the portal; there is no Add, import or delete here. spec: openspec/changes/school-activities-staff-side/specs/school-activities/spec.md#requirement-staff-must-set-an-activitys-places-by-capacity-and-supervision",
				"showTitle": true,
				"entitySource": "endpoint",
				"sourceConfig": {
					"url": "/apps/learniq/api/school-activities",
					"rowsPath": "results",
					"refusedText": "Only the staff who run the school's activities see them."
				},
				"showAddAction": false,
				"showDeleteAction": false,
				"showMassImport": false,
				"showMassCopy": false,
				"showMassDelete": false,
				"columns": [
					{
						"key": "title",
						"label": "Activity"
					},
					{
						"key": "status",
						"label": "Status",
						"enum": [
							"draft",
							"open",
							"closed"
						],
						"enumLabels": {
							"draft": "Draft",
							"open": "Open",
							"closed": "Closed"
						}
					},
					{
						"key": "termStart",
						"label": "Starts",
						"formatter": "date"
					},
					{
						"key": "places",
						"label": "Places",
						"widget": "number"
					},
					{
						"key": "confirmed",
						"label": "Confirmed",
						"widget": "number"
					},
					{
						"key": "waitlist",
						"label": "Waiting list",
						"widget": "number"
					}
				],
				"actions": [
					{
						"id": "open-activity",
						"label": "Open for sign-up",
						"icon": "LockOpenVariantOutline",
						"type": "api-call",
						"method": "PUT",
						"url": "/apps/learniq/api/school-activities/@objectId/open",
						"successMessage": "The activity is open for sign-up.",
						"visibleWhen": {
							"field": "status",
							"op": "eq",
							"value": "draft"
						}
					}
				]
			}
		}
	]
}
