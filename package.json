{
  "name": "learniq",
  "version": "0.1.0",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^22.14 || ^24 || >=26",
    "npm": "^11.0.0"
  },
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src tests scripts",
    "lint-fix": "npm run lint -- --fix",
    "stylelint": "stylelint \"src/**/*.{vue,scss,css}\"",
    "format": "prettier --check \"**/*.{js,ts,vue,css,scss}\"",
    "format:fix": "prettier --write \"**/*.{js,ts,vue,css,scss}\"",
    "stylelint-fix": "stylelint \"src/**/*.{vue,scss,css}\" --fix",
    "check:schema-l10n": "node scripts/check-schema-l10n.js",
    "check:manifest": "node tests/validate-manifest.js",
    "check:board-detail": "node scripts/build-board-detail.mjs --check",
    "l10n:build": "node scripts/build-l10n-js.js",
    "check:l10n-js": "node scripts/build-l10n-js.js --check",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:register": "node tests/validate-register.js && node tests/validate-processing-coverage.js",
    "check:menu-role-gates": "node tests/validate-menu-role-gates.js",
    "check:json-strict": "node tests/validate-json-strict.js",
    "check:l10n": "node tests/l10n/check-l10n-parity.js --ratchet",
    "check:structure-profile": "node --test tests/unit-js/structureProfile.test.mjs",
    "check:attention": "node --test tests/unit-js/attentionDeclaration.test.mjs",
    "check:specs": "npm run check:json-strict && npm run check:manifest && npm run check:board-detail && npm run check:register && npm run check:menu-role-gates && npm run check:structure-profile && npm run check:attention && npm run check:l10n",
    "seed:e2e": "node tests/e2e/seed-example-data.mjs",
    "test:js-unit": "node --test tests/unit-js/*.test.mjs",
    "test:coverage": "c8 --all --src src --include 'src/**/*.js' --reporter=json-summary --reporter=text-summary --reports-dir=coverage-js node --test tests/unit-js/*.test.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@conduction/nextcloud-vue": "^2.203.0",
    "@nextcloud/auth": "^2.5.0",
    "@nextcloud/axios": "~2.6.0",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^8.0.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/password-confirmation": "^6.2.1",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.13.0",
    "@vueuse/core": "^14.0.0",
    "babel-loader": "^10.1.1",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.16",
    "gridstack": "^14.1.1",
    "marked": "^18.0.14",
    "path-browserify": "^1.0.1",
    "pinia": "^3.0.0",
    "stream-browserify": "^3.0.0",
    "vue": "^3.5.46",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^5.3.1",
    "vuedraggable": "^4.1.0"
  },
  "overrides": {
    "libxmljs2": "^0.37.0",
    "dompurify": "$dompurify",
    "webdav": {
      "minimatch": "^11.0.1"
    },
    "@nextcloud/stylelint-config": {
      "stylelint": "$stylelint",
      "stylelint-config-recommended-scss": "$stylelint-config-recommended-scss",
      "stylelint-config-recommended-vue": "$stylelint-config-recommended-vue"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/prettier-config": "^1.2.0",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/webpack-vue-config": "^7.0.0",
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/parser": "^8.70.0",
    "axe-core": "^4.14.1",
    "c8": "^12.0.0",
    "css-loader": "~7.1.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss-html": "^2.0.1",
    "prettier": "^3.9.9",
    "sass": "^1.108.2",
    "sass-loader": "^17.0.1",
    "style-loader": "~4.0.0",
    "stylelint": "^18.1.0",
    "stylelint-config-recommended-scss": "^18.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.4.4",
    "typescript": "^5.0.2",
    "vue-eslint-parser": "^10.4.2",
    "vue-loader": "^17.4.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.1.0"
  },
  "prettier": "@nextcloud/prettier-config"
}
