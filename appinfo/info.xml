    <!--
        AVG Art. 30 verwerkingsregister consumes OpenRegister's per-access
        read-logging capability (the x-openregister-processing dialect,
        ProcessingLogService / ProcessingLogController, and the
        /api/avg/verwerkingen[/betrokkene] endpoints). That capability ships
        from OpenRegister >= 0.2.14. The minimum is also recorded as the
        `openregister` constraint in lib/Settings/learniq_register.json.
    -->
    <dependencies>
        <!--
        App dependencies: openregister and openconnector. Recorded as prose, not
        as elements. The App Store schema (info.xsd) has no app child under
        dependencies, so shipping one fails App Store validation; Nextcloud's
        DependencyAnalyzer does not read it either (it handles only php,
        database, command, lib, os, architecture and the server version), so the
        elements never enforced anything at install time. The openregister
        version floor is recorded as the `openregister` constraint in
        lib/Settings/learniq_register.json, as noted above.
        -->
        <php min-version="8.3" max-version="8.4"/>
        <nextcloud min-version="32" max-version="34"/>
    </dependencies>

    <background-jobs>
        <!--
            LTI AGS grade-passback poll (lti-tool-placement, design.md D2):
            pulls pending nl.conduction.lti.ags.score.received CloudEvent
            messages from OpenConnector's events-cloudevents pull surface and
            creates concept GradeEntry rows. No-ops until an admin bootstraps
            learniq.lti_ags_subscription_id (see docs/ARCHITECTURE.md).
        -->
        <job>OCA\Learniq\BackgroundJob\LtiAgsScorePollJob</job>
        <!-- adopt-connection-registry: once a day, sends integriq the outcome
             of the last EUDI wallet offer. Sends nothing when integriq is not
             installed. -->
        <job>OCA\Learniq\BackgroundJob\ConnectionReportJob</job>
    </background-jobs>

    <repair-steps>
        <!--
            rename-to-learniq ORDERING (both blocks below): RenameRegisterSlug
            and MigrateAppConfigKeys MUST run BEFORE InitializeSettings.

            Renaming the app's <id> means Nextcloud discovers 'learniq' as a
            DIFFERENT app id than 'scholiq' — there is no NC concept of an
            in-place app-id upgrade, so <install> (not only <post-migration>)
            is the realistic path this actually runs through on a real
            deployment. InitializeSettings imports learniq_register.json,
            whose register entry is now keyed/slugged 'learniq'.
            OpenRegister's import handler matches an existing register BY
            SLUG (ImportHandler::importRegister() — "Check if register
            already exists by slug", falling back to "not found, will create
            new one"). If InitializeSettings ran first, it would find no
            register with slug 'learniq' yet (the real one still has the
            old slug 'scholiq' from before this rename), create a NEW EMPTY
            register with slug 'learniq', and RenameRegisterSlug's collision
            guard would then refuse to rename the real, data-carrying
            register — orphaning every existing object under the old,
            now-unreachable slug. Running RenameRegisterSlug first makes the
            real register's slug 'learniq' BEFORE the import runs, so the
            import matches and updates it in place instead of creating a
            duplicate.
        -->
        <post-migration>
            <!--
                rename-to-learniq: single-row UPDATE renaming the register's
                slug scholiq -> learniq. Idempotent, non-destructive, does not
                touch any shard table (shard tables key on the numeric
                register id, not the slug). MUST ship in the same release as
                every literal register-slug call site (see the code changes
                landed alongside this step) — data and code move together.
                MUST run before InitializeSettings — see the ordering note
                above.
            -->
            <step>OCA\Learniq\Repair\RenameRegisterSlug</step>
            <!--
                rename-to-learniq: copies (never deletes) every non-empty
                IAppConfig value stored under the old 'scholiq' app-config
                namespace to the new 'learniq' namespace, including the
                ADR-023 scholiq.actions action-authorization matrix. Idempotent
                (skips a key whose learniq.* destination is already set).
            -->
            <step>OCA\Learniq\Repair\MigrateAppConfigKeys</step>
            <!--
                The background job moved from OCA\Learniq\Cron to
                OCA\Learniq\BackgroundJob in #612. The <job> entry above is a
                REGISTRATION instruction, not a description of state: on upgrade
                Nextcloud ADDS a job it does not have, but never removes one
                whose class disappeared — it cannot tell a renamed class from
                one merely unavailable this boot.

                Measured on a live instance carrying the equivalent opencatalogi
                move: oc_jobs still held OCA\OpenCatalogi\Cron\DirectorySync
                beside its replacement. A row naming a missing class fails to
                build on every cron tick, and logs rather than raises.

                Independent of the rename ordering above — it removes rows and
                creates nothing, so no step depends on it either way.
                post-migration only: a fresh install has no rows to remove.
            -->
            <step>OCA\Learniq\Repair\RemoveRetiredCronJobs</step>
            <!--
                privacy-reuse-openregister-register (D20): copies learniq's own
                DataSubjectRequest rows into OpenRegister's shared
                data-subject-requests register. BEFORE InitializeSettings, while
                the retired schema and its rows are certainly still there.
                Idempotent on the target (a marker line in each case's notes);
                source rows are left in place. post-migration only: a fresh
                install has no rows to move.
            -->
            <step>OCA\Learniq\Repair\MigrateDataSubjectRequestsToOpenRegister</step>
            <!--
                payments-to-shillinq-migration (D19): writes every retired
                Order, OrderLine and PaymentTransaction row to
                payments-archive/retired-payments.json in learniq's app data
                folder. BEFORE InitializeSettings, while those schemas and
                their rows are certainly still readable. Idempotent (skips
                when the file exists); writes nothing when there are no rows.
            -->
            <step>OCA\Learniq\Repair\ArchiveRetiredPaymentObjects</step>
            <!--
                retired-schemas-prune: OpenRegister's import never removes a
                schema, so the four schemas retired above (order, order-line,
                payment-transaction, data-subject-request) would stay forever.
                Removes them the way occ openregister:schemas:prune-retired
                does: unlink from every register, then cascade-delete. AFTER
                the two steps that read their rows: a payment schema goes with
                its rows only when every row is in the archive; privacy
                requests go only when there are none (AVG records stay until
                the school drops them). Idempotent; never aborts the upgrade.
                post-migration only: a fresh install never had them.
            -->
            <step>OCA\Learniq\Repair\PruneRetiredSchemas</step>
            <step>OCA\Learniq\Repair\InitializeSettings</step>
            <!-- teacher-notes-protection: move teacherNote blocks out of lessons into the
                 staff-only lesson-teacher-note schema. After InitializeSettings, which
                 imports that schema; idempotent, a no-op once no lesson holds a note. -->
            <step>OCA\Learniq\Repair\MoveTeacherNotesOutOfLessons</step>
            <!-- ADR-023: seed the action-authorization matrix (default admin-only). -->
            <step>OCA\Learniq\Repair\InitializeActions</step>
            <!-- store-rights-for-teachers (D27): once per instance, add course-store.install
                 and move course-package.share off the untouched old default. After
                 InitializeActions, which owns an empty matrix. -->
            <step>OCA\Learniq\Repair\ApplyStoreRightsDefaults</step>
            <!--
                Must run AFTER the register sync that adds the English columns.
                Covers every renamed property together: a register-scoped step
                that moved some owners and not others would leave the rest
                silently reading null.
            -->
            <step>OCA\Learniq\Repair\RenameDutchColumns</step>
            <!--
                gradeentry-learnerref-stamp: stamps the LearnerProfile UUID on
                grades written before the server did it on every write, so
                they reach the portal. After InitializeSettings (the register
                must exist). Idempotent; a row it cannot resolve is retried on
                the next upgrade.
            -->
            <step>OCA\Learniq\Repair\BackfillGradeEntryLearnerRef</step>
            <!--
                default-tenant fallback (Ruben, 2026-09-29, option A): an unbound
                user's tenant used to be the instance id, which is not a UUID and
                matched no seeded row. Moves rows that carry it to the default
                tenant. After InitializeSettings (the register must exist).
                Idempotent; touches only rows whose tenant_id is the instance id.
            -->
            <step>OCA\Learniq\Repair\MoveInstanceIdTenantToDefaultTenant</step>
            <!--
                data-exchange-to-integriq (D7): archives every retired
                DataExchangeJob, DataMappingProfile, ExchangeRejection and
                ExchangeErrorCode row to data-exchange-archive/, then, when
                integriq is installed, hands the jobs and customised mappings
                to integriq through its events. After InitializeSettings, so
                DossierReview exists for a job that still waits for a parent.
                Runs once (app config exchange_migrated_to_integriq); deletes nothing.
            -->
            <step>OCA\Learniq\Repair\MigrateDataExchangeToIntegriq</step>
            <!--
                learnerrefs-backfill-and-lookup-dedupe: stamps learnerRefs and
                learnerRef on submissions written before the server did, so they
                reach the portal. After InitializeSettings (the register must
                exist). Idempotent; a row it cannot resolve is retried on the
                next upgrade.
            -->
            <step>OCA\Learniq\Repair\BackfillSubmissionLearnerRefs</step>
        </post-migration>
        <install>
            <!--
                rename-to-learniq: registered under <install> too, not only
                <post-migration> — see the ordering note above for why a
                fresh 'learniq' install is the realistic path on a real
                deployment. Both steps are idempotent and safe to run here:
                on a genuinely fresh instance with no prior 'scholiq' data
                they are no-ops (nothing to rename, nothing to copy).
            -->
            <step>OCA\Learniq\Repair\RenameRegisterSlug</step>
            <step>OCA\Learniq\Repair\MigrateAppConfigKeys</step>
            <step>OCA\Learniq\Repair\InitializeSettings</step>
            <!-- ADR-023: seed the action-authorization matrix (default admin-only). -->
            <step>OCA\Learniq\Repair\InitializeActions</step>
        </install>
    </repair-steps>

    <commands>
        <!-- Removes a loaded example set by handing its fixed uuids to
             occ openregister:objects:purge (openspec/changes/archive/2026-09-28-segment-wizard-choice). -->
        <command>OCA\Learniq\Command\ExampleSetRemoveCommand</command>
        <!-- curriculum-coverage-rollup: fills CurriculumCoverage rows for data saved
             before the rollup existed; the listener keeps them current afterwards. -->
        <command>OCA\Learniq\Command\RecomputeCurriculumCoverage</command>
        <!-- portal-guardian-invitation: links a guardian to the parent portal. -->
        <command>OCA\Learniq\Command\PortalInviteGuardianCommand</command>
    </commands>

